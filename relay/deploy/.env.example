# Public DNS name pointing at the Linux host running this stack.
VANTA_DOMAIN=relay.example.com

# TURN address mapping. TURN_PRIVATE_IP is the host interface address that
# coturn binds to; TURN_PUBLIC_IP is the address clients can reach.
# For a directly-addressed public interface, these may be the same address.
# Behind NAT, use the public/private mapping expected by coturn.
TURN_PRIVATE_IP=10.0.0.10
TURN_PUBLIC_IP=203.0.113.10

# Generate a private value, for example with: openssl rand -hex 32
# This must match coturn's static-auth-secret and must never be shipped to clients.
VANTA_TURN_SHARED_SECRET=replace-with-a-random-secret
